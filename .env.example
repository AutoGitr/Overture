AUTH_MODE=password
# Run: docker run --rm -it ghcr.io/autogitr/overture password hash
APP_PASSWORD_HASH=

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Sign in with SSO
OIDC_AUTO_LOGIN=false

SESSION_EXPIRY_DAYS=7

MEDIA_SERVER=plex
MEDIA_SERVER_URL=http://192.0.2.10:32400
MEDIA_SERVER_API_KEY=replace_with_your_media_server_token
MEDIA_SERVER_VERIFY_TLS=true
TMDB_API_KEY=

# APP_URL is the exact browser origin (required for OIDC). Leave blank for direct HTTP access.
APP_URL=
# Only list proxy addresses or networks that append a trustworthy X-Forwarded-For value.
TRUSTED_PROXY_CIDRS=

TZ=UTC
LOG_LEVEL=info
LOG_COLOUR=true
PHASH_WORKERS=1
ART_DOWNLOAD_WORKERS=1
THEME_DOWNLOAD_WORKERS=1
