# https://autogitr.github.io/Overture/overture/install/environment-variables

# Auth
AUTH_MODE=password # password, oidc, both, none
APP_PASSWORD_HASH= # Generate: docker run --rm -it ghcr.io/autogitr/overture password hash
SESSION_EXPIRY_DAYS=7

# OIDC
OIDC_ISSUER_URL= # Required when AUTH_MODE is oidc or both
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Sign in with SSO
OIDC_AUTO_LOGIN=false

# Network
APP_URL= # Required for OIDC; leave blank for direct HTTP
TRUSTED_PROXY_CIDRS= # Trusted proxies for X-Forwarded-For

# Media Servers
MEDIA_SERVERS=Plex # Names, comma-separated, the lead first; none for no server
MEDIA_SERVER_PLEX_TYPE=plex # plex, emby, jellyfin
MEDIA_SERVER_PLEX_URL= # Domain or IP (use HTTPS for Plex)
MEDIA_SERVER_PLEX_API_KEY=
MEDIA_SERVER_PLEX_VERIFY_TLS=true
MEDIA_SERVER_PLEX_PATH_MAP= # server_path=local_path, comma-separated, where the server sees media elsewhere
# A second server: MEDIA_SERVERS=Plex,Jellyfin, then its own variables
#MEDIA_SERVER_JELLYFIN_TYPE=jellyfin
#MEDIA_SERVER_JELLYFIN_URL=
#MEDIA_SERVER_JELLYFIN_API_KEY=
#MEDIA_SERVER_JELLYFIN_VERIFY_TLS=true
#MEDIA_SERVER_JELLYFIN_PATH_MAP=
#MEDIA_SERVER_JELLYFIN_COLLECTIONS_PATH= # Mounted path for writing collection themes

# Metadata
TMDB_API_KEY=
MDBLIST_API_KEY=

# Radarr & Sonarr
RADARR_URL=
RADARR_API_KEY=
RADARR_VERIFY_TLS=true
SONARR_URL=
SONARR_API_KEY=
SONARR_VERIFY_TLS=true

# Notifications
NOTIFY_URL= # Discord, Slack, Telegram, Gotify, ntfy, or Apprise URL

# System
TZ=UTC
LOG_LEVEL=info
LOG_COLOUR=true
PHASH_WORKERS=1
ART_DOWNLOAD_WORKERS=1
THEME_DOWNLOAD_WORKERS=1
