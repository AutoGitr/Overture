AUTH_MODE=password
# Run: docker run --rm -it ghcr.io/autogitr/overture password hash
APP_PASSWORD_HASH=

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Sign in with SSO
OIDC_AUTO_LOGIN=false

SESSION_EXPIRY_DAYS=7

# APP_URL is the exact browser origin (required for OIDC). Leave blank for direct HTTP access.
APP_URL=
# Only list proxy addresses or networks that append a trustworthy X-Forwarded-For value.
TRUSTED_PROXY_CIDRS=

# Media Server
MEDIA_SERVER=plex
MEDIA_SERVER_URL=http://192.0.2.10:32400
MEDIA_SERVER_API_KEY=replace_with_your_media_server_token
MEDIA_SERVER_VERIFY_TLS=true

# Jellyfin's collections directory (mounted into Overture to write BoxSet themes)
JELLYFIN_COLLECTIONS_PATH=

# External metadata providers
TMDB_API_KEY=
MDBLIST_API_KEY=

# Radarr and Sonarr
RADARR_URL=
RADARR_API_KEY=
RADARR_VERIFY_TLS=true
SONARR_URL=
SONARR_API_KEY=
SONARR_VERIFY_TLS=true

# Discord, Slack, Telegram, Gotify, ntfy or Apprise url
NOTIFY_URL=

TZ=UTC
LOG_LEVEL=info
LOG_COLOUR=true
PHASH_WORKERS=1
ART_DOWNLOAD_WORKERS=1
THEME_DOWNLOAD_WORKERS=1
