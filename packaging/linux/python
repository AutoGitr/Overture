#!/bin/sh
# Run the bundled interpreter with the bundled tools first on PATH.
set -eu
bundle=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
export PATH="$bundle/tools:/usr/bin:/bin"
export PYTHONNOUSERSITE=1
export PYTHONSAFEPATH=1
export PYTHONDONTWRITEBYTECODE=1
exec "$bundle/runtime/bin/python3" "$@"
