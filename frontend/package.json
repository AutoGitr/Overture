{
  "name": "overture",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:brand": "bun scripts/generate-brand.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format:check": "bun fmt --check .",
    "format:fix": "bun fmt .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc --build tsconfig.node.json",
    "generate:contracts": "uv run --directory .. python -m scripts.contracts",
    "check:contracts": "uv run --directory .. python -m scripts.contracts --check",
    "skills:sync": "uv run --directory .. python -m scripts.sync_skills",
    "skills:check": "uv run --directory .. python -m scripts.sync_skills --check",
    "skills:update": "uv run --directory .. python -m scripts.sync_skills --update",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "test:oidc": "bun run build && playwright test --config playwright.oidc.config.ts",
    "verify": "bun run typecheck && bun run test:unit && bun run build",
    "lint:deps": "depcruise src --config .dependency-cruiser.mjs",
    "check:bundle": "bun scripts/check-bundle.ts",
    "ci": "bun run format:check && bun run lint:deps && bun run lint && bun run lint:unused && bun run typecheck && bun run test:coverage && bun run build && bun run check:bundle",
    "ci:e2e": "bun run test:e2e",
    "lint:duplication": "jscpd --config ../.jscpd.json",
    "lint:unused": "knip --no-progress"
  },
  "dependencies": {
    "@tanstack/svelte-query": "6.4.4",
    "sv-router": "0.19.0"
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "glob": "14.0.6",
    "js-yaml": "4.3.2",
    "minimatch": "11.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@lucide/svelte": "1.76.0",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-svelte": "3.24.1",
    "fast-check": "4.10.3",
    "globals": "17.14.0",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "knip": "6.46.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
